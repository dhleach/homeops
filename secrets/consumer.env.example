# Consumer service configuration

# Where to read observer events from
EVENT_LOG=state/observer/events.jsonl

# Where to write derived events
DERIVED_EVENT_LOG=state/consumer/events.jsonl

# Rule thresholds and enablement are controlled by the checked-in YAML file.
# Set this only when running against a separately validated test/rollback file.
# HOMEOPS_RULES_CONFIG=services/insights/rules.yaml

# Telegram Bot API credentials for alerts
# Get bot token from @BotFather on Telegram
# Chat ID is your personal Telegram user ID
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_CHAT_ID=<your_telegram_chat_id>

# Optional proactive anomaly insight (disabled by default).
# Enable only with a provider key and the Telegram credentials above.
HOMEOPS_PROACTIVE_INSIGHT_ENABLED=false
# GEMINI_API_KEY=<your_gemini_api_key>
# HOMEOPS_PROACTIVE_INSIGHT_PROVIDER=gemini
# HOMEOPS_PROACTIVE_INSIGHT_MODEL=gemini-2.5-flash
# HOMEOPS_PROACTIVE_INSIGHT_LOOKBACK_HOURS=48
# HOMEOPS_PROACTIVE_INSIGHT_MAX_CONTEXT_CHARS=8000
# HOMEOPS_PROACTIVE_INSIGHT_MAX_OUTPUT_CHARS=1200
# HOMEOPS_PROACTIVE_INSIGHT_TIMEOUT_S=10
# HOMEOPS_PROACTIVE_INSIGHT_DAILY_BUDGET=3
# HOMEOPS_PROACTIVE_INSIGHT_STATE=state/consumer/proactive-insight-state.json
